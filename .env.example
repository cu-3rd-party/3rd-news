# Скопируй в .env — docker compose подхватит его сам.

# --- главный сервис ---------------------------------------------------------
NEWS_ENVIRONMENT=development
# Им подписываются JWT. В проде обязательно поменять.
NEWS_SECRET_KEY=change-me-please
# Публичный адрес сервиса: из него собирается callback_url для классификаторов.
NEWS_PUBLIC_BASE_URL=http://localhost:8000
# Админ создаётся при первом запуске, пока таблица пользователей пуста.
NEWS_BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
NEWS_BOOTSTRAP_ADMIN_PASSWORD=admin

# Способы авторизации клиентских ручек, в порядке проверки (JSON array).
# Добавить "sso", когда будет реализован services/main/app/auth/sso.py.
NEWS_AUTH_BACKENDS=["api_key","jwt","session"]

# Принимать JWT от внешнего издателя (SSO, кампусный шлюз) вместо только своих:
# NEWS_JWT_ALGORITHM=RS256
# NEWS_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
# NEWS_JWT_ISSUER=https://sso.example.edu/
# NEWS_JWT_AUDIENCE=3rd-news

# Откуда ходит админка (JSON array).
NEWS_CORS_ORIGINS=["http://localhost:5173"]

# Какие статусы видны клиентам без права editor (JSON array).
NEWS_PUBLIC_STATUSES=["published"]
# Публиковать сразу, как только классификация закончилась. false — каждую
# новость подтверждает редактор.
NEWS_AUTO_PUBLISH=true

# --- классификаторы ---------------------------------------------------------
# Общий секрет, которым подписываются запросы к классификатору.
REGEX_CLASSIFIER_SECRET=dev-regex-secret
AI_CLASSIFIER_SECRET=dev-ai-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# --- пример RSS-парсера (docker compose --profile parsers) ------------------
# Ключ с правом ingest, выпускается в админке.
RSS_PARSER_API_KEY=
# Формат: slug|url через запятую.
RSS_FEEDS=univ-main|https://example.edu/feed.xml
RSS_POLL_INTERVAL_S=600

# --- админка ----------------------------------------------------------------
VITE_API_URL=http://localhost:8000
