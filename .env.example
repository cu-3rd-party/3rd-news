ENVIRONMENT=development

# Database
DB_SCHEME=postgresql+asyncpg
DB_HOST=db
DB_PORT=5432
DB_NAME=news
DB_USER=news
DB_PASSWORD=news

# Message broker
BROKER_SCHEME=nats
BROKER_HOST=broker
BROKER_PORT=4222

# Search service
SEARCH_SCHEME=http
SEARCH_HOST=search
SEARCH_PORT=7700

# File service
FILE_SCHEME=http
FILE_HOST=file
FILE_PORT=3900
FILE_BUCKET=news
FILE_REGION=garage

# Public API
PUBLIC_API_SCHEME=http
PUBLIC_API_HOST=api
PUBLIC_API_PORT=8000

# File public endpoint
FILE_PUBLIC_SCHEME=http
FILE_PUBLIC_HOST=localhost
FILE_PUBLIC_PORT=8081

# Service listen addresses
SITE_ADDRESS=:8080
UPLOAD_ADDRESS=:8081

# Classifier providers
OPENAI_SCHEME=http
OPENAI_HOST=ollama
OPENAI_PORT=11434
OPENAI_PATH=/v1
OPENAI_API_KEY=
OLLAMA_SCHEME=http
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# News API
NEWS_SCHEME=http
NEWS_HOST=api
NEWS_PORT=8000
PARSER_NEWS_API_KEY=

# RSS parser
RSS_FEEDS=campus|https://example.edu/news.xml
RSS_POLL_INTERVAL_S=600
RSS_MAX_AGE_DAYS=30

# Time
TIME_SCHEME=https
TIME_HOST=time.cu.ru
TIME_PORT=443
TIME_COOKIE=
TIME_CSRF=
TIME_TOKEN=
TIME_CHANNELS=tsentralnyy-universitet/anonsy-tsu

# Parser API
PARSER_API_TOKEN=
